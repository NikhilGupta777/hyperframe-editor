{
  "name": "@hyperframe-editor/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "start": "node ./dist/index.js",
    "dev": "tsx watch src/index.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:gates": "tsx scripts/smoke-gates.ts",
    "smoke:tweak": "tsx scripts/smoke-tweak.ts",
    "smoke:edit-source": "tsx scripts/smoke-edit-source.ts",
    "smoke:edit-source-real": "tsx scripts/smoke-edit-source-real.ts",
    "smoke:budget": "tsx scripts/smoke-budget.ts",
    "smoke:tools": "tsx scripts/smoke-tools.ts",
    "smoke:failure": "tsx scripts/smoke-failure.ts",
    "smoke:autofix": "tsx scripts/smoke-autofix.ts",
    "smoke:dryrun": "tsx scripts/smoke-dryrun.ts",
    "smoke:concat": "tsx scripts/smoke-concat.ts",
    "smoke:composition": "tsx scripts/smoke-composition.ts",
    "smoke:acquire": "tsx scripts/smoke-acquire.ts",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@hyperframe-editor/compose": "workspace:*",
    "@hyperframe-editor/core": "workspace:*",
    "@hyperframe-editor/db": "workspace:*",
    "@hyperframe-editor/ffmpeg": "workspace:*",
    "@hyperframe-editor/providers": "workspace:*",
    "@hyperframe-editor/queue": "workspace:*",
    "@hyperframe-editor/storage": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "execa": "^9.5.2",
    "linkedom": "^0.18.12",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
