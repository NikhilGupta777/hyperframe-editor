# hyperframe-editor environment variables
# Copy this file to apps/web/.env.local for the web app.
# For the Oracle worker, set these in infra/oracle/.env
#
# See DEPLOY.md for full setup instructions.

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED — app won't start without these
# ═══════════════════════════════════════════════════════════════════════════════

# Postgres (Neon free tier recommended)
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ═══════════════════════════════════════════════════════════════════════════════
# REQUIRED FOR RENDER/AGENT (503 without these)
# ═══════════════════════════════════════════════════════════════════════════════

# Redis (Upstash free tier recommended) — enables render queue + SSE
REDIS_URL="rediss://default:xxx@us1-xxx.upstash.io:6379"

# ═══════════════════════════════════════════════════════════════════════════════
# RECOMMENDED — persistent storage for compositions + rendered MP4s
# ═══════════════════════════════════════════════════════════════════════════════

# Amazon S3
STORAGE_BUCKET="hyperframe-editor"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""
# Only set for S3-compatible services (not needed for native AWS S3):
# STORAGE_ENDPOINT="https://custom-endpoint.example.com"
# STORAGE_FORCE_PATH_STYLE="1"

# ═══════════════════════════════════════════════════════════════════════════════
# OPTIONAL — stock media (empty results without keys)
# ═══════════════════════════════════════════════════════════════════════════════

PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ═══════════════════════════════════════════════════════════════════════════════
# WORKER ONLY — set on the Oracle Docker container, NOT on Vercel
# ═══════════════════════════════════════════════════════════════════════════════

# Vertex AI (Gemini 3.1 Pro + image generation)
GOOGLE_APPLICATION_CREDENTIALS="/secrets/sa.json"
GOOGLE_CLOUD_PROJECT=""
GOOGLE_CLOUD_LOCATION="us-central1"

# Worker tuning
WORKER_NAME="worker-1"
WORKER_MAX_CONCURRENT_RENDERS="2"
RENDER_BACKEND="hyperframes"
HEALTH_PORT="8787"
