# hyperframe-editor environment variables
# Copy this file to apps/web/.env.local for the web app,
# and set these on the Oracle worker Docker container.

# ─── Required ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:pass@host:5432/dbname?sslmode=require"

# ─── Worker queue (required for render/agent functionality) ──────────────────
REDIS_URL="redis://localhost:6379"

# ─── OCI Object Storage (required for persistent compositions + renders) ─────
STORAGE_BUCKET="hf-projects"
STORAGE_REGION="us-ashburn-1"
STORAGE_NAMESPACE="your-namespace"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_PUBLIC_BASE_URL=""

# ─── Stock media APIs (optional — empty results without them) ────────────────
PIXABAY_API_KEY=""
UNSPLASH_ACCESS_KEY=""

# ─── Vertex AI (required on the worker for agent loops) ──────────────────────
GOOGLE_APPLICATION_CREDENTIALS="/path/to/service-account.json"
VERTEX_PROJECT_ID=""
VERTEX_LOCATION="us-central1"

# ─── Worker tuning ───────────────────────────────────────────────────────────
WORKER_MAX_CONCURRENT_RENDERS="2"
WORKER_ID="oracle-a1-01"
