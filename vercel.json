{
  "buildCommand": "pnpm -r --filter '@hyperframe-editor/*' build && pnpm --filter @hyperframe-editor/web build",
  "installCommand": "pnpm install --frozen-lockfile",
  "framework": "nextjs",
  "outputDirectory": "apps/web/.next",
  "rootDirectory": ".",
  "functions": {
    "apps/web/app/api/render/[id]/stream/route.ts": {
      "maxDuration": 300
    },
    "apps/web/app/api/agent/turn/route.ts": {
      "maxDuration": 30
    },
    "apps/web/app/api/render/route.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/api/render/:id/stream",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-transform" },
        { "key": "X-Accel-Buffering", "value": "no" }
      ]
    }
  ]
}
